# Copy this file to .env and fill in real values. Never commit .env.

# Groq API key (https://console.groq.com/keys). Required.
GROQ_API_KEY=

# Groq model name. llama-3.3-70b-versatile as of writing - verify current
# name at https://console.groq.com/docs/models before relying on it.
GROQ_MODEL=llama-3.3-70b-versatile

# Port the Express server listens on.
PORT=3000

# Toggles the defense layer (input checks, trust separation, output
# validation) on or off, so the test harness can run the same 30 cases
# before and after defenses and compare results. Accepts "on" or "off".
DEFENSES=on
